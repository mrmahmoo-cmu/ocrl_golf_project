<mujoco model="golf_swing">
  <option timestep="0.0005" gravity="0 0 -9.81" integrator="Euler">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom condim="3" friction="0.8 0.005 0.0001"/>
  </default>

  <contact>
    <pair geom1="club_head" geom2="ball_geom"
          condim="3" friction="0.4 0.4 0.005"
          solref="0.0005 1.0" solimp="0.95 0.99 0.001"/>
  </contact>

  <worldbody>
    <!--
    SWING GEOMETRY (corrected):

    MuJoCo Y-hinge: point at (0,0,-r) rotated by θ → x = -r·sin(θ), z = -r·cos(θ)
    Velocity at θ≈0: dx/dt = -r·cos(θ)·dθ/dt = -r·dθ/dt
    For +X velocity (toward hole): need dθ/dt < 0 at impact

    Setup:
      - Start at θ = +3π/4 (arm up and to -X side = backswing)
      - Apply NEGATIVE torque → θ decreases → arm swings down
      - At θ≈0 (arm straight down): club head near ground, moving +X
      - Ball at x ≈ base_x (slightly ahead)
      - Hole far in +X direction

    The base is directly above the ball so the swing arc bottom
    passes through the ball. The arm/shaft have no ground collision
    (contype=0) — only the club head contacts the ball.
    -->

    <!-- ============ TERRAIN ============ -->
    <geom name="tee_box" type="box" pos="0.5 0 -0.01" size="1.5 2 0.01"
          rgba="0.25 0.6 0.25 1" friction="0.4 0.005 0.0001"/>
    <geom name="fairway" type="box" pos="25 0 -0.01" size="25 5 0.01"
          rgba="0.2 0.55 0.2 1" friction="0.4 0.005 0.0001"/>
    <geom name="green" type="box" pos="47.5 0 -0.01" size="7.5 5 0.01"
          rgba="0.15 0.7 0.15 1" friction="0.15 0.002 0.00005"/>
    <geom name="sand" type="box" pos="37.5 0 -0.005" size="2.5 2 0.005"
          rgba="0.85 0.78 0.55 1" friction="1.2 0.05 0.001"/>
    <geom name="rough_left" type="box" pos="25 -8 -0.01" size="30 3 0.01"
          rgba="0.15 0.4 0.1 1" friction="0.8 0.02 0.0005"/>
    <geom name="rough_right" type="box" pos="25 8 -0.01" size="30 3 0.01"
          rgba="0.15 0.4 0.1 1" friction="0.8 0.02 0.0005"/>
    <geom name="ground" type="plane" size="100 100 0.1" pos="0 0 -0.02"
          rgba="0.15 0.35 0.1 1" friction="0.8 0.02 0.0005"/>

    <light pos="0 -2 3" dir="0 1 -1" diffuse="1 1 1"/>

    <!-- ============ 2-DOF ARM ============ -->
    <!-- Base directly above ball. Height = arm reach + margin -->
    <body name="base" pos="0 0 1.48">
      <geom type="sphere" size="0.04" rgba="0.5 0.5 0.5 1" mass="0"
            contype="0" conaffinity="0"/>

      <body name="upper_arm" pos="0 0 0">
        <joint name="elbow" type="hinge" axis="0 1 0"
               range="-270 270" limited="true"
               damping="2.0" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.35"
              size="0.025" rgba="0.7 0.3 0.3 1" mass="2.0"
              contype="0" conaffinity="0"/>

        <body name="forearm" pos="0 0 -0.35">
          <joint name="wrist" type="hinge" axis="0 1 0"
                 range="-90 90" limited="true"
                 damping="30.0" armature="0.02"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.30"
                size="0.02" rgba="0.3 0.3 0.7 1" mass="1.5"
                contype="0" conaffinity="0"/>

          <body name="club_shaft" pos="0 0 -0.30">
            <geom type="capsule" fromto="0 0 0 0 0 -0.80"
                  size="0.008" rgba="0.8 0.8 0.8 1" mass="0.3"
                  contype="0" conaffinity="0"/>

            <body name="club_head_body" pos="0 0 -0.80">
              <geom name="club_head" type="box" size="0.04 0.02 0.03"
                    rgba="0.9 0.9 0.9 1" mass="0.2"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ============ GOLF BALL ============ -->
    <!-- Slightly ahead of base in +X so club sweeps into it -->
    <body name="ball" pos="0.05 0 0.0214">
      <freejoint name="ball_joint"/>
      <geom name="ball_geom" type="sphere" size="0.0214"
            rgba="1 1 1 1" mass="0.0459"
            friction="0.5 0.005 0.0001"/>
    </body>

    <!-- Hole — far in +X direction -->
    <body name="hole" pos="50.0 0 0.001">
      <geom type="cylinder" size="0.054 0.001"
            rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="elbow_torque" joint="elbow" ctrlrange="-150 150" ctrllimited="true"/>
    <motor name="wrist_torque" joint="wrist" ctrlrange="-60 60" ctrllimited="true"/>
  </actuator>

  <sensor>
    <jointpos name="elbow_pos" joint="elbow"/>
    <jointvel name="elbow_vel" joint="elbow"/>
    <jointpos name="wrist_pos" joint="wrist"/>
    <jointvel name="wrist_vel" joint="wrist"/>
    <framepos name="club_head_pos" objtype="body" objname="club_head_body"/>
    <framequat name="club_head_quat" objtype="body" objname="club_head_body"/>
    <framelinvel name="club_head_vel" objtype="body" objname="club_head_body"/>
    <framepos name="ball_pos" objtype="body" objname="ball"/>
    <framelinvel name="ball_vel" objtype="body" objname="ball"/>
  </sensor>
</mujoco>
