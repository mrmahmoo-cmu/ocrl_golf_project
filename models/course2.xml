<mujoco model="course2_the_ridge">
  <option timestep="0.0005" gravity="0 0 -9.81" integrator="Euler">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom condim="3" friction="0.8 0.005 0.0001"/>
  </default>

  <contact>
    <pair geom1="club_head" geom2="ball_geom"
          condim="3" friction="0.4 0.4 0.005"
          solref="0.0005 1.0" solimp="0.95 0.99 0.001"/>
  </contact>

  <worldbody>
    <!--
    COURSE 2: "The Ridge"

    A longer course (~48m) with a sharp dogleg right, two hills,
    three sand bunkers, and a narrow approach to the green.

    Top-down view:
                        Rough
        ┌──────────────────────────────────────────────┐
        │                                              │
        │  Tee ════ Fairway ═══╗                       │
        │  [●]    Hill1 🏔️    Sand1  ║                 │
        │                       ║ Fairway2             │
        │           Sand2       ║    Hill2 🏔️          │
        │                       ╚══════╗               │
        │                    Fairway3  ║               │
        │                       Sand3  Green  ○ [hole] │
        │                              ▓▓▓▓▓          │
        │                        Rough                 │
        └──────────────────────────────────────────────┘

    Hole at (42, 18). Requires ~22 deg aim angle.
    Wind: 2 m/s crosswind from -Y (pushes ball toward +Y).
    -->

    <!-- ============ ROUGH BASE ============ -->
    <geom name="rough_base" type="box" pos="22 9 -0.27" size="30 18 0.25"
          rgba="0.18 0.42 0.12 1" friction="0.8 0.02 0.0005"/>

    <!-- ============ TEE BOX ============ -->
    <geom name="tee_box" type="box" pos="0.5 0 -0.22" size="2.5 2.5 0.27"
          rgba="0.35 0.75 0.35 1" friction="0.4 0.005 0.0001"/>
    <geom name="tee_marker" type="cylinder" pos="0.05 0 0.06" size="0.05 0.005"
          rgba="0.9 0.2 0.2 1" contype="0" conaffinity="0"/>

    <!-- ============ FAIRWAY SECTIONS ============ -->
    <!-- Section 1: straight ahead, x=3 to x=28 -->
    <geom name="fairway1" type="box" pos="15.5 0 -0.22" size="12.5 4.5 0.27"
          rgba="0.28 0.65 0.28 1" friction="0.4 0.005 0.0001"/>

    <!-- Section 2: first bend, angling toward +Y, x=25 to x=35, y=0 to y=12 -->
    <geom name="fairway2" type="box" pos="30 6 -0.22" size="5 6.5 0.27"
          rgba="0.26 0.63 0.26 1" friction="0.4 0.005 0.0001"/>

    <!-- Section 3: second bend, approaching green, x=33 to x=40, y=10 to y=20 -->
    <geom name="fairway3" type="box" pos="36.5 14 -0.22" size="4 5 0.27"
          rgba="0.26 0.63 0.26 1" friction="0.38 0.005 0.0001"/>

    <!-- ============ HILLS ============ -->
    <!-- Hill 1: on the straight fairway section, forces ball to fly over -->
    <geom name="hill1" type="ellipsoid" pos="12 0 0.05" size="5 3.5 0.6"
          rgba="0.28 0.65 0.28 1" friction="0.45 0.005 0.0001"/>

    <!-- Hill 2: near the bend, narrows the approach corridor -->
    <geom name="hill2" type="ellipsoid" pos="33 8 0.05" size="3.5 3 0.45"
          rgba="0.26 0.63 0.26 1" friction="0.45 0.005 0.0001"/>

    <!-- ============ GREEN ============ -->
    <geom name="green" type="box" pos="42 18 -0.22" size="5 4.5 0.27"
          rgba="0.22 0.82 0.28 1" friction="0.15 0.002 0.00005"/>

    <!-- ============ SAND BUNKERS ============ -->
    <!-- Bunker 1: at the end of the straight section, blocks direct overshoot -->
    <geom name="sand1" type="box" pos="28 -1 -0.22" size="2.5 2 0.28"
          rgba="0.92 0.85 0.60 1" friction="1.2 0.05 0.001"/>

    <!-- Bunker 2: inside the dogleg bend, punishes cutting the corner -->
    <geom name="sand2" type="box" pos="26 6 -0.22" size="2 2.5 0.28"
          rgba="0.92 0.85 0.60 1" friction="1.2 0.05 0.001"/>

    <!-- Bunker 3: greenside, guards the left approach -->
    <geom name="sand3" type="box" pos="39 16 -0.22" size="2 1.5 0.28"
          rgba="0.92 0.85 0.60 1" friction="1.2 0.05 0.001"/>

    <!-- ============ FALLBACK GROUND ============ -->
    <geom name="ground" type="plane" size="100 100 0.1" pos="0 0 -0.52"
          rgba="0.12 0.32 0.08 1" friction="0.8 0.02 0.0005"/>

    <!-- ============ HOLE ============ -->
    <body name="hole" pos="42.0 18.0 0.06">
      <geom name="hole_circle" type="cylinder" size="0.054 0.002"
            rgba="0.05 0.05 0.05 1" contype="0" conaffinity="0"/>
      <geom name="flag_pole" type="cylinder" pos="0 0 0.75" size="0.015 0.75"
            rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>
      <geom name="flag" type="box" pos="0.06 0 1.40" size="0.08 0.005 0.05"
            rgba="0.95 0.15 0.15 1" contype="0" conaffinity="0"/>
    </body>

    <!-- ============ LIGHTS ============ -->
    <light pos="20 5 18" dir="0 0 -1" diffuse="1.0 1.0 0.95" ambient="0.35 0.35 0.35"/>
    <light pos="42 18 12" dir="0 0 -1" diffuse="0.6 0.6 0.6"/>

    <!-- ============ ARM WITH AIM JOINT ============ -->
    <body name="turntable" pos="0 0 1.48">
      <joint name="aim" type="hinge" axis="0 0 1"
             range="-90 90" limited="true"
             damping="1000.0" armature="1.0"/>
      <geom type="sphere" size="0.04" rgba="0.5 0.5 0.5 1" mass="0.01"
            contype="0" conaffinity="0"/>

      <body name="upper_arm" pos="0 0 0">
        <joint name="elbow" type="hinge" axis="0 1 0"
               range="-270 270" limited="true"
               damping="2.0" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.35"
              size="0.025" rgba="0.7 0.3 0.3 1" mass="2.0"
              contype="0" conaffinity="0"/>

        <body name="forearm" pos="0 0 -0.35">
          <joint name="wrist" type="hinge" axis="0 1 0"
                 range="-90 90" limited="true"
                 damping="30.0" armature="0.02"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.30"
                size="0.02" rgba="0.3 0.3 0.7 1" mass="1.5"
                contype="0" conaffinity="0"/>

          <body name="club_shaft" pos="0 0 -0.30">
            <geom type="capsule" fromto="0 0 0 0 0 -0.80"
                  size="0.008" rgba="0.8 0.8 0.8 1" mass="0.3"
                  contype="0" conaffinity="0"/>

            <body name="club_head_body" pos="0 0 -0.80">
              <geom name="club_head" type="box" size="0.04 0.02 0.03"
                    rgba="0.9 0.9 0.9 1" mass="0.2"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ============ GOLF BALL ============ -->
    <body name="ball" pos="0.05 0 0.0214">
      <freejoint name="ball_joint"/>
      <geom name="ball_geom" type="sphere" size="0.0214"
            rgba="1 1 1 1" mass="0.0459"
            friction="0.5 0.005 0.0001"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="elbow_torque" joint="elbow" ctrlrange="-150 150" ctrllimited="true"/>
    <motor name="wrist_torque" joint="wrist" ctrlrange="-60 60" ctrllimited="true"/>
  </actuator>

  <sensor>
    <jointpos name="aim_pos" joint="aim"/>
    <jointpos name="elbow_pos" joint="elbow"/>
    <jointvel name="elbow_vel" joint="elbow"/>
    <jointpos name="wrist_pos" joint="wrist"/>
    <jointvel name="wrist_vel" joint="wrist"/>
    <framepos name="club_head_pos" objtype="body" objname="club_head_body"/>
    <framequat name="club_head_quat" objtype="body" objname="club_head_body"/>
    <framelinvel name="club_head_vel" objtype="body" objname="club_head_body"/>
    <framepos name="ball_pos" objtype="body" objname="ball"/>
    <framelinvel name="ball_vel" objtype="body" objname="ball"/>
  </sensor>
</mujoco>
