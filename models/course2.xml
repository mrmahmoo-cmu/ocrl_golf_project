<mujoco model="course2_gentle_dogleg">
  <option timestep="0.0005" gravity="0 0 -9.81" integrator="Euler">
    <flag contact="enable"/>
  </option>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom condim="3" friction="0.8 0.005 0.0001"/>
  </default>

  <contact>
    <pair geom1="club_head" geom2="ball_geom"
          condim="3" friction="0.4 0.4 0.005"
          solref="0.0005 1.0" solimp="0.95 0.99 0.001"/>
  </contact>

  <worldbody>

    <!-- ROUGH BASE -->
    <geom name="rough_base" type="box" pos="22 4 -0.27" size="28 16 0.25"
          rgba="0.16 0.38 0.10 1" friction="0.8 0.02 0.0005"/>

    <!-- TEE BOX -->
    <geom name="tee_box" type="box" pos="0.5 0 -0.22" size="2.5 2.5 0.27"
          rgba="0.38 0.78 0.38 1" friction="0.4 0.005 0.0001"/>
    <geom name="tee_marker" type="cylinder" pos="0.05 0 0.06" size="0.05 0.005"
          rgba="0.95 0.25 0.25 1" contype="0" conaffinity="0"/>

    <!-- FAIRWAY -->
    <geom name="fairway1" type="box" pos="14 0 -0.22" size="11 4.5 0.27"
          rgba="0.30 0.68 0.30 1" friction="0.4 0.005 0.0001"/>
    <geom name="fairway2" type="box" pos="29 3.5 -0.22" size="4 5.5 0.27"
          rgba="0.30 0.68 0.30 1" friction="0.4 0.005 0.0001"/>
    <geom name="fairway_approach" type="box" pos="35.5 5 -0.22" size="2.5 4.5 0.27"
          rgba="0.30 0.68 0.30 1" friction="0.35 0.005 0.0001"/>

    <!-- HILL -->
    <geom name="hill" type="ellipsoid" pos="15 0 0.05" size="6 4 0.5"
          rgba="0.32 0.70 0.32 1" friction="0.45 0.005 0.0001"/>

    <!-- GREEN -->
    <geom name="green" type="box" pos="38 8 -0.22" size="5.5 5 0.27"
          rgba="0.25 0.85 0.30 1" friction="0.15 0.002 0.00005"/>

    <!-- SAND BUNKERS -->
    <geom name="sand1" type="box" pos="25.5 1 -0.22" size="2.5 2 0.28"
          rgba="0.94 0.88 0.62 1" friction="1.2 0.05 0.001"/>
    <geom name="sand2" type="box" pos="35 11 -0.22" size="2 1.5 0.28"
          rgba="0.94 0.88 0.62 1" friction="1.2 0.05 0.001"/>

    <!-- FALLBACK GROUND -->
    <geom name="ground" type="plane" size="100 100 0.1" pos="0 0 -0.52"
          rgba="0.12 0.32 0.08 1" friction="0.8 0.02 0.0005"/>

    <!-- TREES -->
    <body name="tree1" pos="-2 -5 0">
      <geom type="cylinder" pos="0 0 0.6" size="0.15 0.6" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.5" size="0.8" rgba="0.12 0.45 0.08 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree2" pos="8 -6 0">
      <geom type="cylinder" pos="0 0 0.7" size="0.12 0.7" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.7" size="0.9" rgba="0.10 0.42 0.07 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree3" pos="20 -6 0">
      <geom type="cylinder" pos="0 0 0.5" size="0.13 0.5" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.3" size="0.7" rgba="0.14 0.48 0.10 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree4" pos="15 8 0">
      <geom type="cylinder" pos="0 0 0.6" size="0.14 0.6" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.5" size="0.85" rgba="0.11 0.43 0.08 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree5" pos="25 12 0">
      <geom type="cylinder" pos="0 0 0.7" size="0.15 0.7" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.7" size="0.9" rgba="0.13 0.46 0.09 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree6" pos="42 14 0">
      <geom type="cylinder" pos="0 0 0.55" size="0.12 0.55" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.4" size="0.75" rgba="0.12 0.44 0.08 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree7" pos="44 8 0">
      <geom type="cylinder" pos="0 0 0.8" size="0.16 0.8" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.9" size="1.0" rgba="0.11 0.42 0.07 1" contype="0" conaffinity="0"/>
    </body>
    <body name="tree8" pos="46 5 0">
      <geom type="cylinder" pos="0 0 0.6" size="0.13 0.6" rgba="0.45 0.30 0.15 1" contype="0" conaffinity="0"/>
      <geom type="sphere" pos="0 0 1.5" size="0.8" rgba="0.14 0.47 0.09 1" contype="0" conaffinity="0"/>
    </body>

    <!-- HOLE -->
    <body name="hole" pos="38.0 8.0 0.06">
      <geom name="hole_circle" type="cylinder" size="0.1 0.002"
            rgba="0.05 0.05 0.05 1" contype="0" conaffinity="0"/>
      <geom name="flag_pole" type="cylinder" pos="0 0 0.75" size="0.015 0.75"
            rgba="0.85 0.85 0.85 1" contype="0" conaffinity="0"/>
      <geom name="flag" type="box" pos="0.08 0 1.40" size="0.10 0.005 0.06"
            rgba="0.95 0.15 0.15 1" contype="0" conaffinity="0"/>
    </body>

    <!-- LIGHTS -->
    <light pos="20 0 20" dir="0 0.1 -1" diffuse="1.0 1.0 0.95" ambient="0.4 0.4 0.4"/>
    <light pos="38 8 15" dir="0 0 -1" diffuse="0.5 0.5 0.5"/>

    <!-- ARM WITH AIM JOINT -->
    <body name="turntable" pos="0 0 1.48">
      <joint name="aim" type="hinge" axis="0 0 1" range="-90 90" limited="true" damping="1000.0" armature="1.0"/>
      <geom type="sphere" size="0.04" rgba="0.5 0.5 0.5 1" mass="0.01" contype="0" conaffinity="0"/>
      <body name="upper_arm" pos="0 0 0">
        <joint name="elbow" type="hinge" axis="0 1 0" range="-270 270" limited="true" damping="2.0" armature="0.05"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.35" size="0.025" rgba="0.7 0.3 0.3 1" mass="2.0" contype="0" conaffinity="0"/>
        <body name="forearm" pos="0 0 -0.35">
          <joint name="wrist" type="hinge" axis="0 1 0" range="-90 90" limited="true" damping="30.0" armature="0.02"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.30" size="0.02" rgba="0.3 0.3 0.7 1" mass="1.5" contype="0" conaffinity="0"/>
          <body name="club_shaft" pos="0 0 -0.30">
            <geom type="capsule" fromto="0 0 0 0 0 -0.80" size="0.008" rgba="0.8 0.8 0.8 1" mass="0.3" contype="0" conaffinity="0"/>
            <body name="club_head_body" pos="0 0 -0.80">
              <geom name="club_head" type="box" size="0.04 0.02 0.03" rgba="0.9 0.9 0.9 1" mass="0.2"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- GOLF BALL -->
    <body name="ball" pos="0.05 0 0.0214">
      <freejoint name="ball_joint"/>
      <geom name="ball_geom" type="sphere" size="0.0214" rgba="1 1 1 1" mass="0.0459" friction="0.5 0.005 0.0001"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="elbow_torque" joint="elbow" ctrlrange="-150 150" ctrllimited="true"/>
    <motor name="wrist_torque" joint="wrist" ctrlrange="-60 60" ctrllimited="true"/>
  </actuator>

  <sensor>
    <jointpos name="aim_pos" joint="aim"/>
    <jointpos name="elbow_pos" joint="elbow"/>
    <jointvel name="elbow_vel" joint="elbow"/>
    <jointpos name="wrist_pos" joint="wrist"/>
    <jointvel name="wrist_vel" joint="wrist"/>
    <framepos name="club_head_pos" objtype="body" objname="club_head_body"/>
    <framequat name="club_head_quat" objtype="body" objname="club_head_body"/>
    <framelinvel name="club_head_vel" objtype="body" objname="club_head_body"/>
    <framepos name="ball_pos" objtype="body" objname="ball"/>
    <framelinvel name="ball_vel" objtype="body" objname="ball"/>
  </sensor>
</mujoco>